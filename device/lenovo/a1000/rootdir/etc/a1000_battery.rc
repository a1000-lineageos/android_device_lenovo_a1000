# A1000: сохранение уровня заряда между перезагрузками.
#
# Без этого при каждой загрузке заряд оценивается заново по напряжению, а на
# зарядке оно завышено током — отсюда скачки на десяток процентов. Драйвер
# умеет принять сохранённое значение (атрибут save_capacity) и сам проверяет
# его на вменяемость; не хватало только того, кто это значение хранит.
#
# late_start — потому что нужен смонтированный /data. Заряд к этому моменту
# уже показан неверно пару секунд, но дальше он становится правильным.

service a1000_batcap /system/bin/a1000_batcap.sh
    class late_start
    user root
    group root system
    seclabel u:r:su:s0
