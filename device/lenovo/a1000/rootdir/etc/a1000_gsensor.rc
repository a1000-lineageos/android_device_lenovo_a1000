# A1000: ориентация акселерометра.
#
# Чип mc3xxx стоит ЛИЦОМ ВНИЗ и вдобавок развёрнут относительно экрана.
# Проверено измерением, а не подбором: лёжа экраном вверх датчик выдавал
# Z = -1012, хотя Android ждёт +1012, а в портрете основная тяжесть шла по Y.
#
# Заводская таблица монтажа (mc3xxx_cvt в драйвере) покрывала только 4 из 8
# сочетаний для случая «лицом вниз», и нужного среди них не было: на варианте
# 6 портрет вставал верно, а альбом получался зеркальным. Недостающие
# сочетания добавлены в драйвер как 12..15, нужное — 13.
#
# Значение по умолчанию в самом драйвере тоже 13, но после загрузки параметр
# почему-то читается нулём, поэтому дублируем записью отсюда. Меняется живьём:
#   cat  /sys/module/mc3xxx/parameters/mc3xxx_current_placement
#   echo 6 > /sys/module/mc3xxx/parameters/mc3xxx_current_placement
# Применяется к следующему же чтению датчика, перезагрузка не нужна.
#
# ВАЖНО: init в 8.1 разбирает ВСЕ файлы в /system/etc/init, а не только *.rc.
# Бэкапы сюда класть НЕЛЬЗЯ.

on boot
    write /sys/module/mc3xxx/parameters/mc3xxx_current_placement 13

on property:sys.boot_completed=1
    write /sys/module/mc3xxx/parameters/mc3xxx_current_placement 13
