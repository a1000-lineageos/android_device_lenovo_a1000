# A1000: постоянный сбор логов в /cache/logs для последующего разбора.
#
# Человек с таким же аппаратом делает в TWRP бэкап раздела cache и присылает
# архив — внутри лежат логи текущей и предыдущей загрузки, журнал причин
# перезагрузок и лог загрузчика.
#
# class late_start, а не core: нужен смонтированный /data (tombstones, ANR) и
# уже поднятый logd. Первые секунды загрузки при этом не теряются — они всё
# равно остаются в кольцевом буфере ядра, который скрипт снимает целиком.

service a1000_logs /system/bin/a1000_logs.sh
    class late_start
    user root
    group root system log
    seclabel u:r:su:s0
