# A1000: перестановка красного и синего в аппаратном оверлее — ВЫКЛЮЧЕНА.
#
# Вывод идёт без копирования кадра: шим libsprdshim_fbpost меняет только адрес
# сканирования через SPRD_FB_PAGEFLIP, а не перенастраивает слой на каждый
# кадр. На этом пути верный цвет = osd_rb_ov 0 ПЛЮС debug.sf.swz=bgr
# (проверено глазом 21.08.2026).
#
# На ПРЕЖНЕМ пути (SET_OVERLAY на каждый кадр) верной была единица: там
# overlay_osd_configure() переписывал DISPC_OSD_CTRL целиком. Историю не
# путать: если когда-нибудь вернётесь к длинному пути, значение тоже надо
# вернуть в 1.
#
# Это дубль страховки: то же значение стоит значением по умолчанию в самом
# драйвере (sprdfb_dispc.c), поэтому первые кадры бут-анимации, которые идут
# ДО post-fs, тоже выходят верного цвета.
#
# Меняется живьём, без перезапуска SurfaceFlinger (короткий путь подтверждает
# бит на каждом перевороте):
#   echo 1 > /sys/module/sprdfb_dispc/parameters/osd_rb_ov
# (-1 = не трогать регистр вовсе)
#
# ВАЖНО: init в 8.1 разбирает ВСЕ файлы в /system/etc/init, а не только *.rc.
# Бэкапы этого файла класть сюда НЕЛЬЗЯ — они отработают следом и перебьют
# значение. Держать их в /system/etc/.
#
# Триггер именно post-fs: early-init и init для файлов из /system/etc/init на
# этом устройстве не срабатывают — они разбираются уже после тех этапов.
on post-fs
    write /sys/module/sprdfb_dispc/parameters/osd_rb_ov 0

on boot
    write /sys/module/sprdfb_dispc/parameters/osd_rb_ov 0
