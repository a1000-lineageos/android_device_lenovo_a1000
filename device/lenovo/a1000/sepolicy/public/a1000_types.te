# A1000: свои типы для вендорных узлов /dev.
# Объявлены в ПУБЛИЧНОЙ части, потому что нужны обеим половинам политики:
# на sprd_wcn_device ссылается платформенный домен init (под ним работает
# wcnd), на sprd_jpg_device — вендорный hal_camera_default.
#
# Отдельные типы, а не разрешение на общий device:chr_file: под init работает
# не только wcnd, и раздавать ему весь класс устройств слишком широко.
type sprd_wcn_device, dev_type;
type sprd_jpg_device, dev_type;
